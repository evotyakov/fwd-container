# ================================
# C++ Project .gitignore
# ================================

# Компилируемые файлы
*.exe
*.out
*.app
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.dylib

# Отладочная информация
*.pdb
*.idb
*.ilk
*.exp
*.map
*.db

# Папки сборки
build/
Debug/
Release/
x64/
x86/
Win32/
x64-Debug/
x64-Release/
.vs/
out/
bin/
obj/
[Bb]in/
[Oo]bj/

# Visual Studio
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.opensdf
*.sdf
ipch/
*.aps
*.ncb
*.opendb
*.db

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
CTestTestfile.cmake
_deps/
*.cmake

# JetBrains IDEs
.idea/
*.iml

# Системные файлы
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Логи
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Тестовые отчеты
test-results/
coverage/
*.coverage
*.lcov

# Документация
docs/_build/

# Временные файлы
*.tmp
*.temp
*~
*.swp
*.swo

# Пакеты
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Служебные файлы проекта
.project
.classpath
.cproject
.settings/

# ================================
# Project-specific exclusions
# ================================

# Google Test (если скачан в проект)
googletest/
gtest_build/

# Ваши исполняемые файлы тестов
tests.exe
test_*.exe
run_tests.exe
unittests.exe

# Папка с зависимостями (если есть)
deps/
third_party/
external/

# Файлы данных (если есть)
*.dat
*.csv
*.json
*.xml